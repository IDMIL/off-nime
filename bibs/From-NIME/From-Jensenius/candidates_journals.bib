@article{murphy2015expressivero,
	author = {Jim Murphy and James McVay and Paul Mathews and Dale A. Carnegie and Ajay Kapur},
	title = {Expressive Robotic Guitars: Developments in Musical Robotics for Chordophones},
	journal = {Computer Music Journal},
	year = {2015},
